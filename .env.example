DATABASE_URL=mysql://luxe:change-me@localhost:3306/luxestore

AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Public address of the site, for canonical links, the sitemap and social previews (defaults to AUTH_URL)
NEXT_PUBLIC_SITE_URL=

ADMIN_EMAIL=
ADMIN_PASSWORD=

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=
# Unguessable string. Put the same value in the callback URL as ?token=...  (e.g. https://host/api/mpesa/callback?token=VALUE)
MPESA_CALLBACK_SECRET=
# TILL (Buy Goods): MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline, MPESA_SHORTCODE = the store/head-office number
# from your Daraja go-live email, MPESA_PARTY_B = the Till number customers pay to.
MPESA_PARTY_B=
# Optional second lock: comma-separated IPs Safaricom posts callbacks from (copy the current list from the Daraja portal).
# Leave empty to rely on the token alone. If you set it, a wrong list blocks real payments, so test one payment after.
MPESA_CALLBACK_ALLOWED_IPS=

# Product photo storage. Set Cloudinary (recommended) or leave empty to save photos on this machine.
# Either the single URL from the Cloudinary dashboard...
CLOUDINARY_URL=
# ...or the three values separately
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary media library (default: luxestore)
CLOUDINARY_FOLDER=
# Local storage only: folder for uploaded photos (default: ./uploads)
UPLOAD_DIR=
